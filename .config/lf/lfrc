# lf file manager configuration

# Options

set shell 'bash'
set shellflag '-c'
set shellopts '-eu'
set history true

set selmode all

set anchorfind true
set ignorecase true
set smartcase true
set incsearch true
set incfilter true
set wrapscan true

set dircache true
set dirfirst true
set sortby natural

set scrolloff 3
set wrapscroll false

set tabstop 4
set drawbox false
set roundbox true
set ratios 1:2:3

set number false
set relativenumber false

set preview true
set previewer ~/.config/lf/lf_kitty_preview
set cleaner ~/.config/lf/lf_kitty_clean

# Mappings

map <delete> delete

# "Execute" file
map x $$f
map X !$f

# Custom Commands

cmd edit-config ${{
    $EDITOR ~/.config/lf/lfrc
    lf -remote "send $id source ~/.config/lf/lfrc"
}}

cmd z-jump ${{
  lf -remote "send ${id} cd \"$($ZLUA_SCRIPT -e $@ | sed 's/\\/\\\\/g;s/"/\\"/g')\""
}}
map Z push :z-jump<space>-I<space>
map zb push :z-jump<space>-b<space>
map zz push :z-jump<space>

cmd on-select &{{
    lf -remote "send $id set statfmt \"$(eza -ld --color=always "$f")\""
}}

cmd tar ${{
    set -f
    mkdir $1
    cp -r $fx $1
    tar -czf $1.tar.gz $1
    rm -rf $1
}}

cmd zip ${{
    set -f
    mkdir $1
    cp -r $fx $1
    zip -r $1.zip $1
    rm -rf $1
}}

cmd xopen &{{
    for prg in $fx; do
        setsid nohup xdg-open "$prg" >/dev/null 2>/dev/null &
    done
}}
map o xopen

cmd pager ${{
    if hash bat 2>/dev/null; then
        bat --paging=always $f
    else
        less $f
    fi
}}
map i pager
